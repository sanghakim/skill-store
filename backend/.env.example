# SkillForge Configuration
# Copy this file to .env and fill in your values.

# ── Claude API (Required for real LLM) ──
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Claude Model (Optional) ──
# Options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4-20250514
# Default: claude-sonnet-4-20250514
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Claude Retry (Optional) ──
# Number of automatic retries on API errors
# CLAUDE_MAX_RETRIES=2

# ── Web Search APIs (for deep-researcher skill) ──
# At least one is recommended. Priority: Tavily > Brave > Google > DuckDuckGo(free)

# Tavily Search API — optimized for AI agents (recommended)
# Get your key at: https://app.tavily.com/
# TAVILY_API_KEY=tvly-your-key-here

# Brave Search API
# Get your key at: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=your-key-here

# Google Custom Search API
# GOOGLE_API_KEY=your-key-here
# GOOGLE_CX=your-cx-here
